{
  "name": "maison",
  "version": "1.0.0",
  "description": "MAISON — an idle design-house game. Static build lives in app.js; rebuild from src/app.jsx with npm run build.",
  "private": true,
  "scripts": {
    "build": "esbuild src/app.jsx --bundle --minify --jsx=automatic --outfile=app.js",
    "start": "npx -y serve ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
